# 发布部署参数模板：复制为 deploy/deploy.env 后按实际填写（实文件不入库）
# scripts/deploy.sh 前置校验本文件与关键字段，缺失即中止、不进入任何阶段

# —— 远程主机（传输与远端拉起阶段使用；--dry-run 不触碰）——
DEPLOY_HOST=服务器地址
DEPLOY_USER=登录用户
DEPLOY_PATH=/opt/eladmin-plus

# —— 生产栈运行参数（compose 同名变量注入，缺省走内联默认）——
# web 容器宿主端口（生产栈唯一对外端口）
WEB_PORT=80
# 数据库：库名与账号密码需与容器初始化、应用连接一致
MYSQL_DATABASE=eladmin_plus
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=root
# DATASOURCE_URL 缺省指向栈内 mysql:3306，跨机库等场景按需覆盖
# 手动备份经容器执行：生产 mysql 容器名与 dev 不同，需覆盖 OPS_BACKUP_CONTAINER（如 eladmin-plus-prod-mysql）
